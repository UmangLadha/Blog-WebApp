{
  "name": "fahhh-error-sound",
  "displayName": "Fahhh Error Sound",
  "description": "Plays the iconic 'FAHHH' meme sound whenever an error occurs in your code or terminal. Because errors should be dramatic! 🔊",
  "version": "1.0.0",
  "publisher": "umang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "fahhh",
    "meme",
    "sound",
    "error",
    "fun",
    "humor"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fahhhErrorSound.toggle",
        "title": "Fahhh: Toggle Error Sound"
      },
      {
        "command": "fahhhErrorSound.testSound",
        "title": "Fahhh: Test Sound"
      }
    ],
    "configuration": {
      "title": "Fahhh Error Sound",
      "properties": {
        "fahhhErrorSound.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the FAHHH sound on errors."
        },
        "fahhhErrorSound.cooldownMs": {
          "type": "number",
          "default": 3000,
          "minimum": 500,
          "maximum": 30000,
          "description": "Minimum time (ms) between sound plays to prevent spamming."
        },
        "fahhhErrorSound.detectCodeErrors": {
          "type": "boolean",
          "default": true,
          "description": "Play sound when code diagnostic errors are detected."
        },
        "fahhhErrorSound.detectTerminalErrors": {
          "type": "boolean",
          "default": true,
          "description": "Play sound when terminal error output is detected."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
